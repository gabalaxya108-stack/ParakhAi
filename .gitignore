# ==============================================================================
# Git Ignore Configuration for PARAKH AI
# ==============================================================================

# Environment files and credentials (CRITICAL: NEVER TRACK SECRETS)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
*.env
*.pem
*.key

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Node & Frontend build artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database files & inspection runtime history
*.db
*.sqlite
*.sqlite3
legal_metrology.db
data/inspections.db
data/uploads/*
!data/uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
backend/reports/*
!backend/reports/.gitkeep
data/reports/*
!data/reports/.gitkeep

# Operating System & IDE
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
