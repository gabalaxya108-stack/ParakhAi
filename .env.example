# ==============================================================================
# Legal Metrology Compliance Platform — Environment Configuration Template
# ==============================================================================

# Core Application Settings
PROJECT_NAME="Legal Metrology Compliance Platform"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# Server Bindings
HOST="0.0.0.0"
PORT=8000

# CORS Allowed Origins (Comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Relational Database Configuration (PostgreSQL 15+)
DATABASE_URL="postgresql://localhost:5432/legal_metrology"

# Storage & Upload Configuration
UPLOAD_DIR="data/uploads"
MAX_UPLOAD_SIZE_MB=15

# Optical Character Recognition (OCR) Provider: "mock" | "azure_vision" | "tesseract"
OCR_PROVIDER="mock"
AZURE_VISION_ENDPOINT=""
AZURE_VISION_KEY=""

# AI Declaration Extraction Provider: "mock" | "openai"
EXTRACTION_PROVIDER="mock"
OPENAI_API_KEY=""

# Microsoft Entra ID (Azure AD) Authentication Configuration
ENTRA_TENANT_ID="your-azure-ad-tenant-id"
ENTRA_CLIENT_ID="your-azure-ad-client-id"
ENTRA_CLIENT_SECRET=""
