# ==============================================================================
# PARAKH AI — Backend Environment Template (Production / Railway)
# ==============================================================================

PROJECT_NAME="PARAKH AI"
VERSION=1.0.0
API_V1_STR=/api/v1
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Server Bindings (Railway assigns PORT dynamically)
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated URLs or JSON list, e.g. your Railway frontend domain)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Database Connection (Railway PostgreSQL provides DATABASE_URL)
DATABASE_URL=postgresql://user:password@host:port/database

# Grok / Groq API Configuration
GROK_API_KEY=
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_CHAT_MODEL=qwen/qwen3.8-27b
